# Apache config for the Hetzner webhosting. Mirrors _headers / _redirects, which only
# Cloudflare Pages reads (they are not uploaded by the deploy workflow).

# Always HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# legacy URLs from the previous site
RedirectMatch 301 ^/runs/?$        /#runs
RedirectMatch 301 ^/impressum/?$   /impressum.html
RedirectMatch 301 ^/membership/?$  /membership.html
RedirectMatch 301 ^/documents/code-of-conduct\.pdf$         /code-of-conduct.pdf
RedirectMatch 301 ^/documents/statutes\.pdf$                /satzung.pdf
RedirectMatch 301 ^/documents/membership-application\.pdf$  /membership-application.pdf

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # File names carry no content hash, so nothing may be cached blindly: browsers keep
  # their copy but revalidate it on every visit (a cheap 304 when unchanged).
  Header set Cache-Control "no-cache"
</IfModule>
