# Same headers as .htaccess; change both together.
# File names carry no content hash, so nothing may be cached blindly: browsers keep
# their copy but revalidate it on every visit (a cheap 304 when unchanged).
/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# The application form is meant to be filled in offline: download it.
/membership-application.pdf
  Content-Disposition: attachment
